# ---------------------------------------------------------------------------
# Prodigi web — environment configuration
#
# EVERYTHING prefixed with VITE_ is compiled into the public JavaScript bundle.
# Treat every value here as PUBLIC. Never put API keys, provider secrets,
# database credentials or private tokens in this file. AI provider keys belong
# on the backend service behind VITE_API_URL — never in the frontend.
# ---------------------------------------------------------------------------

# Canonical origin used for canonical URLs, Open Graph, sitemap and schema.
VITE_SITE_URL=https://prodiginl.com

# Demo mode: AI chat, agents, search and voice run on a local demo engine
# (no backend, no AI model). Set to "false" AND provide VITE_API_URL to use
# the real API adapter. If VITE_API_URL is empty, demo mode is always used.
VITE_DEMO_MODE=true

# Base URL of the backend that implements:
#   POST /api/ai/chat   POST /api/ai/agent   POST /api/ai/search   POST /api/ai/voice
# Example: https://api.prodiginl.com  (no trailing slash)
VITE_API_URL=

# Optional endpoint that accepts the contact form as JSON (POST).
# When empty, the contact flow composes an email to VITE_CONTACT_EMAIL instead.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_EMAIL=info@prodiginl.com

# Analytics — loaded ONLY after the visitor gives consent.
# Provider: none | ga4 | clarity | posthog
VITE_ANALYTICS_PROVIDER=none
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

