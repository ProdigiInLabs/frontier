{
  "name": "prodigi-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Prodigi backend: real-time AI chat, search, agent and voice, backed by Google Gemini and MongoDB.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:knowledge && npm run build",
    "sync-knowledge": "node scripts/sync-knowledge.mjs",
    "check:knowledge": "node scripts/sync-knowledge.mjs --check"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "mongoose": "^8.20.1",
    "multer": "^2.4.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "ws": "^8.19.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5 || ^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5 || ^10.0.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
