# ---------------------------------------------------------------------------
# Prodigi backend — server-side configuration.
#
# This file documents the required variables. Copy to .env for local dev
# (never commit .env). In production (Render), set these as dashboard
# environment variables / secrets — never in source control.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# Comma-separated list of origins allowed to call this API (no trailing slash).
# The site's own origin, plus localhost for local frontend dev.
ALLOWED_ORIGINS=http://localhost:5173,https://prodiginl.com

# --- MongoDB (Atlas free tier — see docs/BACKEND.md for setup steps) -------
MONGODB_URI=

# --- Google Gemini (free tier — see docs/BACKEND.md for setup steps) ------
# Get a key at https://aistudio.google.com/apikey (no cost, no credit card).
GEMINI_API_KEY=
# Text/search/agent model. Override if Google renames or retires this id.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Realtime voice model (Gemini Live). Verify the current id in AI Studio —
# live-capable model names change more often than text models.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE_NAME=Kore

# Max concurrent realtime voice sessions (protects the free tier from overload).
MAX_VOICE_SESSIONS=4
